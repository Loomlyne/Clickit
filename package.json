{
  "name": "clickit-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/unit/*.test.ts' 'tests/unit/**/*.test.ts'",
    "gen-types": "supabase gen types typescript --project-id \"lajguozmtissnnfccmej\" --schema public > src/lib/database.types.ts",
    "rewrite-slugs": "node scripts/rewrite-slugs.mjs",
    "fix-archived-show-duplicates": "node scripts/fix-archived-show-duplicates.mjs",
    "r2:media": "node scripts/migrate-supabase-media-to-r2.mjs",
    "gate:local": "npm run lint && npm run test:unit && npm run build && npm run cf:build",
    "cf:guard:local": "HOME=/Users/koss/.clickit-cloudflare node scripts/cf/wrangler-guard.mjs --local",
    "cf:build": "npm run cf:build:preview",
    "cf:build:preview": "npm run cf:guard:local && HOME=/Users/koss/.clickit-cloudflare node scripts/cf/build-target.mjs --target preview",
    "cf:build:workersdev": "npm run cf:guard:local && HOME=/Users/koss/.clickit-cloudflare node scripts/cf/build-target.mjs --target workersdev --media-flag off",
    "cf:preview": "npm run cf:guard:local && npm run cf:build:preview && HOME=/Users/koss/.clickit-cloudflare opennextjs-cloudflare preview",
    "cf:deploy:workersdev": "HOME=/Users/koss/.clickit-cloudflare node scripts/cf/deploy.mjs --target workersdev",
    "cf:deploy:media": "HOME=/Users/koss/.clickit-cloudflare node scripts/cf/deploy.mjs --target media --env \"\"",
    "cf-typegen": "HOME=/Users/koss/.clickit-cloudflare wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "media:health": "node scripts/media-health.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "1.6.2",
    "@opennextjs/cloudflare": "1.20.12",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aws4fetch": "1.0.20",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.4.2",
    "next-intl": "^4.9.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.72.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
