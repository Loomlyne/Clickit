  "about": {
    "metaTitle": "About | Clickit Story",
    "metaDescription": "About Clickit Story and the editorial point of view behind the platform.",
    "eyebrow": "About Clickit Story",
    "title": "A viewing platform built by editorial taste, not an algorithm.",
    "intro": "Clickit Story brings original programming from Abu Dhabi into a calmer, more intentional viewing environment. The thesis is simple: less noise, clearer selection, and a tone that respects the viewer's time.",
    "section1Heading": "Editorial first",
    "section1Body": "The platform is programmed like a magazine or a channel, with attention to pacing, mood, and discovery order instead of overwhelming the viewer with an overcrowded interface.",
    "section2Heading": "Built from Abu Dhabi",
    "section2Body": "The programming starts from the city but does not stay narrow. Travel, food, health, music, and design appear here as adjacent lenses on the region.",
    "section3Heading": "Complete viewing",
    "section3Body": "The product is designed to encourage complete viewing of an episode or season, with clear navigation, saved progress, and room to discover what comes next without noise.",
    "ctaLabel": "Contact the team"
  },
