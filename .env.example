# Names only, never values. Copy what you need into the file named in each comment.
# build env file (workers.dev: /Users/koss/.clickit-cloudflare/clickit.workersdev.env; preview: .env.preview.local)
NEXT_PUBLIC_SUPABASE_URL=
# build env file (same files as NEXT_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# build env file (https workers.dev or clickitstory.ae origin for workers.dev builds)
NEXT_PUBLIC_SITE_URL=
# set by scripts/cf/build-target.mjs per target (empty unless the media flag is verified); never in the env file
NEXT_PUBLIC_MEDIA_ORIGIN=
# set by scripts/cf/build-target.mjs only for a verified workers.dev build; never in the env file
NEXT_PUBLIC_MEDIA_CUTOVER_READY=
# local only: set to 1 by the preview build; the deploy guard refuses a build carrying it
NEXT_PUBLIC_MEDIA_ALLOW_LOOPBACK=
# build env file (public site key; empty until Turnstile is set up)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# build env file (public beacon token; empty until Web Analytics is set up)
NEXT_PUBLIC_CF_BEACON_TOKEN=
# wrangler secret (production); .dev.vars for local preview only
SUPABASE_SERVICE_ROLE_KEY=
# wrangler secret (production); .dev.vars for local preview only
CRON_SECRET=
# wrangler secret (production); .dev.vars for local preview only
TURNSTILE_SECRET_KEY=
# wrangler secret (production); .dev.vars for local preview only
R2_ACCESS_KEY_ID=
# wrangler secret (production); .dev.vars for local preview only
R2_SECRET_ACCESS_KEY=
# wrangler.jsonc vars (not a secret)
CLOUDFLARE_ACCOUNT_ID=
# wrangler.jsonc vars (not a secret)
CLOUDFLARE_R2_BUCKET=
# wrangler secret (production); .dev.vars for local preview only
RESEND_API_KEY=
# wrangler.jsonc vars or wrangler secret, set when email is wired
RESEND_FROM_EMAIL=
# local only: .dev.vars and .env.preview.local; the deploy guard refuses a build or a wrangler var that carries it
LOCAL_DEV=
# local only: the preview build sets it to false; leave unset for deployed builds
CSP_UPGRADE_INSECURE=
