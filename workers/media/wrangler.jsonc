// media.clickitstory.ae — ClickitStory account only (controller deploys).
//
// PRODUCTION DEPLOYS USE `--env supabase-only` (or the bare top level, which is
// the same: no R2) UNTIL THE R2 MIRROR GATE IN DNS-PLAN.md §5d PASSES. Never
// deploy `--env r2` before that: R2-first would serve stale bytes for any image
// the app overwrote in Supabase but not in R2.
//
//   HOME=/Users/koss/.clickit-cloudflare npx wrangler@4 deploy -c workers/media/wrangler.jsonc --env supabase-only
{
  "name": "clickit-media",
  "main": "src/index.ts",
  "account_id": "e329b099b6e4272fc0915a99832e47fe",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://lajguozmtissnnfccmej.supabase.co"
  },
  // clickitstory.ae zone is Active in this account since 2026-10-20.
  "routes": [{ "pattern": "media.clickitstory.ae", "custom_domain": true }],
  // No R2 binding at the top level on purpose: a bare `wrangler deploy` cannot flip production to R2-first.
  "env": {
    // Production today: same Worker, Supabase originals only.
    "supabase-only": {
      "name": "clickit-media",
      "routes": [{ "pattern": "media.clickitstory.ae", "custom_domain": true }],
      "vars": {
        "SUPABASE_URL": "https://lajguozmtissnnfccmej.supabase.co"
      }
    },
    // R2 first, Supabase fallback. Only after the gate in DNS-PLAN.md §5d passes.
    "r2": {
      "name": "clickit-media",
      "routes": [{ "pattern": "media.clickitstory.ae", "custom_domain": true }],
      "vars": {
        "SUPABASE_URL": "https://lajguozmtissnnfccmej.supabase.co"
      },
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "clickit-media" }]
    }
  }
}
