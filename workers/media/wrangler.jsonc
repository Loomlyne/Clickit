// media.clickitstory.ae — ClickitStory account only.
// Deploy: HOME=/Users/koss/.clickit-cloudflare npx wrangler@4 deploy -c workers/media/wrangler.jsonc [--env supabase-only]
{
  "name": "clickit-media",
  "main": "src/index.ts",
  "account_id": "e329b099b6e4272fc0915a99832e47fe",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://lajguozmtissnnfccmej.supabase.co"
  },
  // Target state: R2 first. Needs R2 enabled and bucket clickit-media created.
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "clickit-media" }],
  // Custom domain is attached only after the clickitstory.ae zone is active
  // in this account (owner step). Uncomment then:
  // "routes": [{ "pattern": "media.clickitstory.ae", "custom_domain": true }],
  "env": {
    // Same Worker name, no R2 binding: serves Supabase originals while R2 is off.
    "supabase-only": {
      "name": "clickit-media",
      "vars": {
        "SUPABASE_URL": "https://lajguozmtissnnfccmej.supabase.co"
      },
      "r2_buckets": []
    }
  }
}
